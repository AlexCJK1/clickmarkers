 "google-drive": {
  "label": "Google Drive",
  "private": true,
  "type": "stdio",
  "command": "node",
  "args": [
   "{root}/servers/google.mjs",
   "drive"
  ],
  "own": true,
  "needs": [
   "GOOGLE_OAUTH_CLIENT_ID",
   "GOOGLE_OAUTH_CLIENT_SECRET",
   "GOOGLE_REFRESH_TOKEN"
  ],
  "auth": "oauth",
  "disabled": false,
  "verified": true,
  "readOnly": [
   "drive_search",
   "drive_read"
  ],
  "outbound": [
   "drive_create_file",
   "drive_create_folder",
   "drive_update_file",
   "drive_move",
   "drive_share"
  ],
  "notes": "The office's own Google connector, signed in as the office account (nightdesk connect google). Free: drive_search, drive_read. After the owner's OK: drive_create_file, drive_create_folder, drive_update_file, drive_move, drive_share (drive_share emails the person). Nothing can be deleted."
 },
