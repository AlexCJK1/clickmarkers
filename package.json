{
  "name": "nightdesk",
  "version": "0.1.0",
  "private": true,
  "description": "An AI marketing agency of desks that runs on your own computer: it writes your posts, watches your ads and leads, and nothing goes out without your OK.",
  "scripts": {
    "demo": "node bin/nightdesk.mjs demo",
    "demo:show": "node bin/nightdesk.mjs demo --show",
    "start": "node bin/nightdesk.mjs serve",
    "check": "node bin/nightdesk.mjs check",
    "test": "node --test test/*.test.mjs",
    "build": "vite build",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:fixtures": "node scripts/ui-fixtures.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "marketing",
    "claude",
    "small-business",
    "mcp",
    "marketing-automation",
    "local-first"
  ],
  "author": "Alex Cojoaca",
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "imapflow": "^2.4.0",
    "mailparser": "^3.9.38",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.6"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "ogg-opus-decoder": "^1.7.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "bin": {
    "nightdesk": "bin/nightdesk.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexCJK1/nightdesk.git"
  },
  "homepage": "https://github.com/AlexCJK1/nightdesk#readme",
  "bugs": {
    "url": "https://github.com/AlexCJK1/nightdesk/issues"
  }
}
